[Unit]
Description=AppelerMamie - TV control agent (calls, ringtone, mouse, CEC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace YOUR_USER with the name of the Raspberry user (install.sh does it)
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/AppelerMamie
ExecStart=/home/YOUR_USER/AppelerMamie/venv/bin/python3 -u /home/YOUR_USER/AppelerMamie/main.py
Restart=always
RestartSec=10
# The agent tells systemd it is alive every 30 s (agent.py); stuck for
# 2 minutes, it is restarted
WatchdogSec=120
NotifyAccess=main

[Install]
WantedBy=multi-user.target
